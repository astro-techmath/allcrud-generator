public class {{allcrudEntityName}}Controller extends CrudController<{{allcrudEntityName}}, {{allcrudPojoClassName}}, {{allcrudIdType}}> {

    private final {{allcrudEntityName}}Service service;
    private final {{allcrudEntityName}}Converter converter;

    public {{allcrudEntityName}}Controller({{allcrudEntityName}}Service service, {{allcrudEntityName}}Converter converter) {
        this.service = service;
