import com.techmath.allcrud.service.CrudService;
import {{allcrudPojoPackage}}.{{allcrudPojoClassName}};
import {{allcrudEntityPackage}}.{{allcrudEntityName}};
import {{allcrudServicePackage}}.{{allcrudEntityName}}Service;
import {{allcrudConverterPackage}}.{{allcrudEntityName}}Converter;

import org.springframework.web.bind.annotation.RestController;
import org.springframework.web.bind.annotation.RequestMapping;

{{>generatedAnnotation}}
@RestController
{{#useRequestMappingOnController}}
@RequestMapping("{{allcrudBasePath}}")
{{/useRequestMappingOnController}}
{{#operations}}
public class {{allcrudEntityName}}Controller extends CrudController<{{allcrudEntityName}}, {{allcrudPojoClassName}}, {{allcrudIdType}}> {

    private final {{allcrudEntityName}}Service service;
    private final {{allcrudEntityName}}Converter converter;

    public {{allcrudEntityName}}Controller({{allcrudEntityName}}Service service, {{allcrudEntityName}}Converter converter) {
        this.service = service;
        this.converter = converter;
    }

    @Override
    protected CrudService<{{allcrudEntityName}}, {{allcrudIdType}}> getService() {
        return service;
    }

    @Override
    protected Converter<{{allcrudEntityName}}, {{allcrudPojoClassName}}, {{allcrudIdType}}> getConverter() {
        return converter;
    }

}
{{/operations}}
