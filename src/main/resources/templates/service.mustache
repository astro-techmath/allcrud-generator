    public {{allcrudEntityName}}Service({{allcrudEntityName}}Repository repository) {
        this.repository = repository;
    }

    @Override
    protected EntityRepository<{{allcrudEntityName}}, {{allcrudIdType}}> getRepository() {
        return repository;
    }

}
