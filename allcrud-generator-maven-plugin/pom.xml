<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>io.github.astro-techmath</groupId>
    <artifactId>allcrud-generator-maven-plugin</artifactId>
    <version>0.1.0</version>
    <packaging>maven-plugin</packaging>

    <name>Allcrud Generator Maven Plugin</name>
    <description>Maven plugin for Allcrud Generator - wires contract-first code generation from an OpenAPI spec plus an allcrud-generator.yml config file into the Maven build lifecycle.</description>
    <url>https://github.com/astro-techmath/allcrud-generator</url>

    <licenses>
        <license>
            <name>MIT License</name>
            <url>https://opensource.org/licenses/MIT</url>
        </license>
    </licenses>

    <developers>
        <developer>
            <id>mathmferreira</id>
            <name>Matheus de Almeida Maia Ferreira</name>
            <email>mathmferreira@gmail.com</email>
        </developer>
    </developers>

    <scm>
        <connection>scm:git:git://github.com/astro-techmath/allcrud-generator.git</connection>
        <developerConnection>scm:git:ssh://github.com/astro-techmath/allcrud-generator.git</developerConnection>
        <url>https://github.com/astro-techmath/allcrud-generator</url>
    </scm>

    <properties>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- Same class of bug already fixed on the Gradle side (signAllPublications requiring a
             signatory even for publishToMavenLocal): maven-gpg-plugin's sign goal, bound to the
             verify phase, otherwise requires a real keyring for every plain `mvn verify` - which is
             exactly what CI's own regular build/test step runs, with no key configured (correctly
             so, it's not a real publish). gpg.skip is the plugin's own native property (property
             expression "gpg.skip", built-in default false) - overridden to true here, then flipped
             back with -Dgpg.skip=false only in release.yml's real `mvn deploy` step. Confirmed as a
             real CI failure (gpg: no default secret key), not assumed. -->
        <gpg.skip>true</gpg.skip>
        <maven.plugin.api.version>3.9.16</maven.plugin.api.version>
        <maven.plugin.annotations.version>3.15.2</maven.plugin.annotations.version>
        <maven.plugin.plugin.version>3.15.2</maven.plugin.plugin.version>
        <maven.core.version>3.9.16</maven.core.version>
    </properties>

    <!-- See docs/notes/allcrud-generator-maven-plugin-pom.xml.md#separate-maven-built-module-maven-plugin-plugin-has-no-gradle-native-equivalent -->

    <dependencies>
        <dependency>
            <groupId>org.apache.maven</groupId>
            <artifactId>maven-plugin-api</artifactId>
            <version>${maven.plugin.api.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.maven</groupId>
            <artifactId>maven-core</artifactId>
            <version>${maven.core.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.maven.plugin-tools</groupId>
            <artifactId>maven-plugin-annotations</artifactId>
            <version>${maven.plugin.annotations.version}</version>
            <scope>provided</scope>
        </dependency>
        <!-- See docs/notes/allcrud-generator-maven-plugin-pom.xml.md#allcrud-generator-dependency-resolved-from-mavenlocal-same-coordinate-as-the-gradle-plugin -->
        <dependency>
            <groupId>io.github.astro-techmath</groupId>
            <artifactId>allcrud-generator</artifactId>
            <version>0.1.0</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-plugin-plugin</artifactId>
                <version>${maven.plugin.plugin.version}</version>
                <configuration>
                    <goalPrefix>allcrud-generator</goalPrefix>
                </configuration>
                <executions>
                    <execution>
                        <id>default-descriptor</id>
                        <goals>
                            <goal>descriptor</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!-- Central Portal publishing - successor to the discontinued nexus-staging-maven-plugin.
                 Reads credentials from a <server id="central"> block in settings.xml (no env-var
                 support), generated by actions/setup-java's server-id/server-username/server-password
                 inputs in CI. autoPublish=true matches the Gradle side's publishAndReleaseToMavenCentral
                 (releases automatically once validation passes, no manual step in the Portal UI). -->
            <plugin>
                <groupId>org.sonatype.central</groupId>
                <artifactId>central-publishing-maven-plugin</artifactId>
                <version>0.11.0</version>
                <extensions>true</extensions>
                <configuration>
                    <publishingServerId>central</publishingServerId>
                    <autoPublish>true</autoPublish>
                </configuration>
            </plugin>

            <!-- Unlike Gradle's vanniktech plugin, maven-gpg-plugin has no in-memory-key mode - it
                 needs the key already imported into a real keyring before this runs. In CI,
                 actions/setup-java's gpg-private-key input imports the same SIGNING_KEY secret used
                 on the Gradle side into an isolated keyring automatically; gpg-passphrase points at
                 the env var this plugin reads the passphrase from. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-gpg-plugin</artifactId>
                <version>3.2.8</version>
                <executions>
                    <execution>
                        <id>sign-artifacts</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>sign</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
